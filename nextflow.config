// 1. Core Runtime Configurations
workDir = '/mnt/d/HEV_Analysis/Human/work'
cleanup = true // Deletes heavy intermediate task directories automatically upon success!

executor {
    name   = 'local'
    cpus   = 6
    memory = '16 GB'
}

// 2. Global Pipeline Parameter Defaults
params {
    // Input/Output targets (Local Only)
    reads         = "/mnt/d/HEV_Analysis/Human/Raw_data/*.fastq.gz"
    genome_dir    = "/mnt/d/HEV_Analysis/Human/Reference_genome/GCF_000001405.40"
    outdir        = "/mnt/d/HEV_Analysis/Human/Results"
        
    // Algorithm cutoffs
    threads       = 4
    qual_cutoff   = 20
    min_len       = 36
}

// 3. Process-Specific Resource and Environment Tuning
process {
    executor    = 'local'
    stageInMode = 'symlink' // Zero disk overhead shortcuts

    withName: 'SALMON_INDEX' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'SALMON_QUANT' {
        cpus     = 4
        memory   = '6 GB'
        maxForks = 2
    }
    withName: 'FASTP' {
        cpus     = 4
        memory   = '4 GB'
        maxForks = 2
    }
    withName: 'FASTQC' {
        cpus     = 2
        memory   = '2 GB'
        maxForks = 3
    }
    
}